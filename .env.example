# ============================================================================
# Flowie — environment variables
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# --- Supabase (required for real auth, cloud sync & Google OAuth) ----------
# Project URL WITHOUT the /rest/v1 suffix, e.g. https://abcdwxyz.supabase.co
VITE_SUPABASE_URL=

# The PUBLIC anon key (starts with "eyJ..."). Safe to expose client-side —
# it is protected by Row Level Security. Do NOT use the service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Gemini (optional — enables the AI stylist) -----------------------------
# Free tier key from Google AI Studio. If empty, the on-device heuristic
# engine is used automatically.
VITE_GEMINI_API_KEY=

# --- Hugging Face Spaces + ZeroGPU (garment reconstruction) ----------------
# No VITE_ prefix on anything below: server-side / local scripts only,
# never bundled into client-side code. Never commit .env.
# Free token from https://huggingface.co/settings/tokens. Authenticated calls
# burn YOUR ZeroGPU quota (free = 5 min/day).
HF_TOKEN=
# --- Garment recon (new pipeline) -------------------------------------------
# TryOffDiff recon Space (baseline renderer):
HF_TRYOFF_SPACE_ID=
# Self-hosted Qwen-Image-Edit recon Space (hf-qwen/, print-fidelity spike).
# When set, the harness --qwen flag targets YOUR Space; when empty it falls
# back to the official Qwen Space (currently refused by the ZeroGPU
# scheduler). Same HF_TOKEN works for both (one token, shared quota pool).
HF_QWEN_SPACE_ID=
# Self-hosted FLUX.2-klein detail Space (hf-klein/, amani-b/klein-garment-test).
# DETAIL renderer for print garments (wearer-set hasPrint flag): keeps
# graphics/text legible where TryOffDiff drops them (~60 s/call vs ~30 s).
# ALSO an Edge Function secret: dashboard → Edge Functions → Secrets →
# HF_KLEIN_SPACE_ID (without it, print recons 503 with a clear message).
HF_KLEIN_SPACE_ID=
