# ============================================================================
# Flowie — environment variables
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# --- Supabase (required for real auth, cloud sync & Google OAuth) ----------
# Project URL WITHOUT the /rest/v1 suffix, e.g. https://abcdwxyz.supabase.co
VITE_SUPABASE_URL=

# The PUBLIC anon key (starts with "eyJ..."). Safe to expose client-side —
# it is protected by Row Level Security. Do NOT use the service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Gemini (optional — enables the AI stylist) -----------------------------
# Free tier key from Google AI Studio. If empty, the on-device heuristic
# engine is used automatically.
VITE_GEMINI_API_KEY=

# --- AI flat-lay (optional, BILLABLE — prototype default is OFF/free) ------
# Gemini image output has no free tier (~$0.03-0.06/image). The app NEVER
# calls it unless this is exactly "true": the free on-device composite +
# SVG carry the whole experience. When "true", calls are hybrid (budgeted
# auto on upload + explicit "Flat-lay" tap) capped at 2/day locally.
# Target model: gemini-3.1-flash-image (2.5-flash-image sunsets Oct 2026).
VITE_ENABLE_FLATLAY_AI=

# --- Cloudflare Workers AI (Phase 2+ — img2img garment enhancement) --------
# Free account, no credit card. Token + Account ID from the Cloudflare
# dashboard → Workers AI → "Use REST API". These have NO VITE_ prefix on
# purpose: they must never be bundled into client-side code. Used only by
# local Node test scripts (scripts/cf-img2img-test.mjs). Never commit .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Hugging Face Spaces + ZeroGPU (Phase 2/3 — garment img2img) ------------
# Space ID of YOUR deployed Space (hf-space/README.md, 2-min deploy):
# Gradio SDK, ZeroGPU hardware, app.py = SDXL-Turbo + @spaces.GPU.
# Called from Node via @gradio/client (scripts/space-img2img-test.mjs).
# No VITE_ prefix: local Node test scripts only, never client-bundled.
# NOTE: `gradio_client` is the Python package — wrong stack for this repo.
# The JS equivalent used here is `@gradio/client` (same Gradio protocol).
HF_SPACE_ID=
# Free token from https://huggingface.co/settings/tokens. Authenticated calls
# burn YOUR ZeroGPU quota (free = 5 min/day). Never commit .env.
HF_TOKEN=
